# Versions and parameters of the environment: compose.yaml and bin/xbt read them from here.
# Put local overrides in .env.local, which is not committed.

# Bitcoin Knots release, and the sha256 of its Linux tarballs from the release's SHA256SUMS.
KNOTS_VERSION=29.4.3.knots20260508
KNOTS_SHA256_AMD64=4c67f1139b668fc3b98e339dd16112c636b2c0f42c2294b98fb92d1d27943e24
KNOTS_SHA256_ARM64=ec968672b3733751c09f3805987bd1962a4a033737d4d9334328f77298b5d7b0

# Fulcrum Electrum server with BLAKE2b support (github.com/privkeyio/Fulcrum), pinned by digest.
FULCRUM_IMAGE=ghcr.io/privkeyio/fulcrum:v2.1.4-blake@sha256:ad43ff6709c1d1807a904011ab5a9b5a073b52eda0b0de51671301d34cb4fc76

# RPC credentials of the Knots node, used by every service and by bin/xbt. They are the ones ACINQ's test
# suites expect, and are only safe because the node runs regtest with its ports published on 127.0.0.1.
XBT_RPC_USER=foo
XBT_RPC_PASSWORD=bar

# Regtest height at which BLAKE2b proof of work and version 2 headers activate.
XBT_BLAKE2B_HEIGHT=150

# Median time past at which the RDTS (BIP 110) rules stop applying on regtest. Mainnet's value
# (2027-09-01 00:00 UTC), so regtest enforces them like mainnet.
XBT_RDTS_EXPIRY=1819756800

# Blocks mined when the environment starts: past the activation, with mature coinbase outputs.
XBT_INITIAL_BLOCKS=200
